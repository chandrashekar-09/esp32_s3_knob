# Ignore the workspace databases and settings
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# 1. Ignore everything inside the .pio directory
.pio/*

# 2. Prevent Git from ignoring the specific subdirectories we need to navigate
!.pio/build/
!.pio/build/esp32dev/

# 3. Explicitly track only the firmware.bin file
!.pio/build/esp32dev/firmware.bin
