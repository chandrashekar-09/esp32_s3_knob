# VS Code files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# 1. Allow Git into the .pio directory, but ignore everything directly inside it
!.pio/
.pio/*

# 2. Allow Git into the build directory, but ignore everything directly inside it
!.pio/build/
.pio/build/*

# 3. Allow Git into the esp32dev directory, but ignore everything directly inside it
!.pio/build/esp32dev/
.pio/build/esp32dev/*

# !.pio/build/esp32dev/
# .pio/build/esp32dev/*

# 4. Explicitly allow ONLY the firmware.bin file
!.pio/build/esp32dev/firmware.bin
